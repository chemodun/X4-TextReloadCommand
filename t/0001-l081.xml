      <!-- mod identity -->
      <t id="1">テキスト再読み込みコマンド</t>
      <t id="2">チャットコマンド /reloadtext と /rtx で、ゲームの実行中にゲームと拡張機能のすべてのテキストファイルを再読み込みします。</t>

      <!-- Messages (1000) -->
      <t id="1000">テキストを再読み込みしました。</t>
      <t id="1001">テキストの再読み込みに失敗しました: %s</t>
      <t id="1002">デバッグレベル: %s</t>
      <t id="1003">使い方: /rtx - テキストを再読み込み; /rtx none|debug|trace - デバッグレベル; /rtx reply on|off - 再読み込み後にチャットで応答</t>
      <t id="1004">再読み込み後のチャット応答: オン</t>
      <t id="1005">再読み込み後のチャット応答: オフ</t>

      <!-- Section: General (90000) -->
      <t id="90000">一般</t>
      <t id="90010">再読み込み後にチャットで応答する</t>

      <!-- Section: Debug (90900) -->
      <t id="90900">デバッグ</t>
      <t id="90910">デバッグレベル</t>
      <t id="90911">なし</t>
      <t id="90912">デバッグ</t>
      <t id="90913">トレース</t>
    </page>
